# MongoDB credentials
MONGO_USERNAME=admin
MONGO_PASSWORD=changeme

# CORS allowed origins — в prod укажи домен/IP сервера
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT — обязательно задать в проде (32+ символа)
JWT_SECRET=change-me-to-a-very-long-secret-string
JWT_TTL_MS=3600000

# Admin bootstrap credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-strong-password

# Yandex Object Storage (S3-совместимое)
# Создать сервисный аккаунт с ролью storage.editor, выпустить статические ключи:
# https://console.yandex.cloud → Object Storage → Создать бакет → Доступ: публичный
# Статические ключи: IAM → Сервисный аккаунт → Создать ключ
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_BUCKET=benua-images
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=
YC_S3_PUBLIC_BASE_URL=https://benua-images.storage.yandexcloud.net

